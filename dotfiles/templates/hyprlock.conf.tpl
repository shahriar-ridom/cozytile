# Generated by Cozytile ({{label}}). Run:  hyprlock -c ~/.config/cozytile/generated/hypr/hyprlock.conf
# Customise from Settings > Lock screen.
general {
    hide_cursor = true
    ignore_empty_input = true
}

animations {
    enabled = true
    bezier = ease, 0.22, 1, 0.36, 1
    animation = fadeIn, 1, 4, ease
    animation = fadeOut, 1, 3, ease
    animation = inputFieldDots, 1, 2, ease
}

background {
    monitor =
    path = {{lock_wallpaper}}
    blur_passes = {{lock_blur}}
    blur_size = 7
    noise = 0.012
    contrast = 0.95
    brightness = {{lock_dim}}
    vibrancy = 0.2
}
{{#if lock_status}}
# Top row: now playing on the left, keyboard layout (+ battery) on the right
label {
    monitor =
    text = cmd[update:3000] a=$(playerctl metadata artist 2>/dev/null); t=$(playerctl metadata title 2>/dev/null); [ -n "$t" ] && echo "${a:+$a - }$t" | cut -c1-60
    color = {{fg|rgba:cc}}
    font_size = 13
    font_family = SF Pro Text Medium
    position = 18, -12
    halign = left
    valign = top
}

label {
    monitor =
    text = $LAYOUT
    color = {{fg|rgba:cc}}
    font_size = 13
    font_family = SF Pro Text Medium
    position = {{lock_layout_x}}, -12
    halign = right
    valign = top
}
{{/if}}
{{#if lock_battery}}
label {
    monitor =
    text = cmd[update:30000] cat /sys/class/power_supply/BAT*/capacity | head -1 | sed 's/$/%/'
    color = {{fg|rgba:cc}}
    font_size = 13
    font_family = SF Pro Text Medium
    position = -18, -12
    halign = right
    valign = top
}
{{/if}}
{{#if lock_date}}
label {
    monitor =
    text = cmd[update:60000] date '+%A, %B %-d'
    color = {{fg|rgba:e6}}
    font_size = {{lock_date_size}}
    font_family = SF Pro Display Semibold
    position = 0, -7.5%
    halign = center
    valign = top
}
{{/if}}
label {
    monitor =
    text = cmd[update:1000] date '+{{lock_time_fmt}}'
    color = {{fg|rgba:d9}}
    font_size = {{lock_clock_size}}
    font_family = {{lock_font}}
    position = 0, {{lock_clock_y}}
    halign = center
    valign = top
}
{{#if lock_avatar}}
image {
    monitor =
    path = {{lock_avatar}}
    size = 84
    rounding = -1
    border_size = 2
    border_color = {{fg|rgba:66}}
    position = 0, -31%
    halign = center
    valign = center
}
{{/if}}
{{#if lock_user}}
label {
    monitor =
    text = $USER
    color = {{fg|rgba:f2}}
    font_size = 15
    font_family = SF Pro Text Semibold
    position = 0, -38%
    halign = center
    valign = center
}
{{/if}}

input-field {
    monitor =
    size = 240, 38
    outline_thickness = 1
    outer_color = {{fg|rgba:33}}
    dots_size = 0.24
    dots_spacing = 0.4
    dots_center = true
    inner_color = {{dim|rgba:55}}
    font_color = {{fg|hypr}}
    font_family = SF Pro Text
    check_color = {{yellow|hypr}}
    fail_color = {{red|hypr}}
    capslock_color = {{orange|hypr}}
    fade_on_empty = false
    placeholder_text = <span foreground="##{{fg|nohash}}99">{{lock_hint}}</span>
    fail_text = <i>$FAIL</i>
    rounding = -1
    position = 0, -43%
    halign = center
    valign = center
}
