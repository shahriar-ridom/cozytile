# Generated by Cozytile ({{label}}). Run:  hyprlock -c ~/.config/cozytile/generated/hypr/hyprlock.conf
general {
    hide_cursor = true
    ignore_empty_input = true
}

background {
    monitor =
    path = {{wallpaper}}
    blur_passes = 3
    blur_size = 6
    noise = 0.01
    brightness = 0.72
    vibrancy = 0.15
}

# Two-tone clock card, echoing the bar
shape {
    monitor =
    size = 380, 190
    color = {{dim|rgba:d9}}
    rounding = 18
    border_size = 0
    position = 0, 120
    halign = center
    valign = center
}

label {
    monitor =
    text = $TIME
    color = {{fg|hypr}}
    font_size = 84
    font_family = CaskaydiaCove Nerd Font Bold
    position = 0, 150
    halign = center
    valign = center
}

label {
    monitor =
    text = cmd[update:60000] date '+%A, %d %B'
    color = {{accent|hypr}}
    font_size = 18
    font_family = CaskaydiaCove Nerd Font
    position = 0, 85
    halign = center
    valign = center
}

input-field {
    monitor =
    size = 300, 48
    outline_thickness = 0
    dots_size = 0.26
    dots_spacing = 0.35
    dots_center = true
    inner_color = {{bg3|hypr}}
    font_color = {{fg|hypr}}
    check_color = {{yellow|hypr}}
    fail_color = {{red|hypr}}
    capslock_color = {{orange|hypr}}
    fade_on_empty = false
    placeholder_text = <span foreground="##{{muted|nohash}}">  $USER</span>
    fail_text = <i>$FAIL</i>
    rounding = 24
    position = 0, -40
    halign = center
    valign = center
}
