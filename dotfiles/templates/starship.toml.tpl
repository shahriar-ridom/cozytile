# Generated by Cozytile ({{label}}). Powerline prompt in Cozytile's stepped-shade style.
"$schema" = 'https://starship.rs/config-schema.json'
add_newline = true

format = """
[](fg:{{bg2}})\
$os\
[](fg:{{bg2}} bg:{{bg3}})\
$directory\
[](fg:{{bg3}} bg:{{bg4}})\
$git_branch\
$git_status\
[](fg:{{bg4}} bg:{{bg5}})\
$c$rust$golang$nodejs$python\
[](fg:{{bg5}})\
$cmd_duration\
$line_break\
$character"""

[os]
disabled = false
style = "fg:{{accent}} bg:{{bg2}}"
format = "[ $symbol ]($style)"
[os.symbols]
Arch = ""
CachyOS = "󰣇"
Linux = ""

[directory]
style = "fg:{{fg}} bg:{{bg3}}"
format = "[ $path ]($style)"
truncation_length = 3
truncation_symbol = "…/"
[directory.substitutions]
"Documents" = "󰈙"
"Downloads" = ""
"Pictures" = ""
"Music" = "󰝚"

[git_branch]
symbol = ""
style = "bg:{{bg4}}"
format = "[[ $symbol $branch ](fg:{{yellow}} bg:{{bg4}})]($style)"

[git_status]
style = "bg:{{bg4}}"
format = "[[($all_status$ahead_behind )](fg:{{orange}} bg:{{bg4}})]($style)"

[nodejs]
symbol = ""
style = "bg:{{bg5}}"
format = "[[ $symbol( $version) ](fg:{{green}} bg:{{bg5}})]($style)"
[python]
symbol = ""
style = "bg:{{bg5}}"
format = "[[ $symbol( $version) ](fg:{{blue}} bg:{{bg5}})]($style)"
[rust]
symbol = ""
style = "bg:{{bg5}}"
format = "[[ $symbol( $version) ](fg:{{orange}} bg:{{bg5}})]($style)"
[golang]
symbol = ""
style = "bg:{{bg5}}"
format = "[[ $symbol( $version) ](fg:{{aqua}} bg:{{bg5}})]($style)"
[c]
symbol = ""
style = "bg:{{bg5}}"
format = "[[ $symbol( $version) ](fg:{{blue}} bg:{{bg5}})]($style)"

[cmd_duration]
min_time = 2000
format = " [󰔛 $duration](fg:{{fg2}})"

[line_break]
disabled = true

[character]
success_symbol = "[❯](bold fg:{{accent}})"
error_symbol = "[❯](bold fg:{{red}})"
